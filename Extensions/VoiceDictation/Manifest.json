{
  "schemaVersion": 1,
  "id": "io.github.charafchnioune.nativ.voice-dictation",
  "version": "1.0.0",
  "minimumNativVersion": "0.1.0",
  "displayName": "Audio",
  "summary": "Private, local audio capabilities including meeting capture, voice notes, transcription, summaries, dictation, analytics, and shortcuts.",
  "developer": "Nativ",
  "systemImage": "waveform.badge.mic",
  "included": true,
  "enabledByDefault": false,
  "runtime": "extensionFoundation",
  "extensionPoint": "io.github.charafchnioune.nativ.nativ-extension",
  "runtimeBundleIdentifier": "io.github.charafchnioune.nativ.VoiceDictationExtension",
  "contributions": {
    "sidebar": [
      {
        "id": "io.github.charafchnioune.nativ.voice-dictation.audio",
        "title": "Audio",
        "systemImage": "waveform.badge.mic",
        "order": 250
      }
    ],
    "commands": [
      {
        "id": "io.github.charafchnioune.nativ.voice-dictation.show-recordings",
        "title": "Show Audio Library",
        "systemImage": "waveform"
      }
    ],
    "shortcuts": [
      {
        "id": "io.github.charafchnioune.nativ.voice-dictation.transcribe",
        "title": "Transcribe",
        "defaultShortcut": "Fn+Control"
      },
      {
        "id": "io.github.charafchnioune.nativ.voice-dictation.retranscribe",
        "title": "Retranscribe",
        "defaultShortcut": "Fn+R"
      }
    ],
    "settings": [
      {
        "id": "io.github.charafchnioune.nativ.voice-dictation.model",
        "title": "Speech-to-text model"
      },
      {
        "id": "io.github.charafchnioune.nativ.voice-dictation.animation",
        "title": "Animation"
      },
      {
        "id": "io.github.charafchnioune.nativ.voice-dictation.shortcuts",
        "title": "Shortcuts"
      }
    ]
  },
  "permissions": [
    "microphone",
    "audio.systemCapture",
    "accessibility.insertText",
    "models.speechToText",
    "overlay",
    "storage.namespaced"
  ]
}
